<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/operations_description" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/operations_status_heading"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/operationsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/retryUploads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/retry_uploads_now" />

        <Button
            android:id="@+id/applyRetention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/apply_retention_now" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/safe_queue_heading"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/operationsRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/refreshOperations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/refresh_operations" />

        <Button
            android:id="@+id/shareQueue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_safe_queue" />

        <Button
            android:id="@+id/shareDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_redacted_diagnostics" />

        <Button
            android:id="@+id/shareConfiguration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_configuration" />

        <Button
            android:id="@+id/shareMask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_active_mask" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pending_deletion_safety" />
    </LinearLayout>
</ScrollView>
